[Unit]
Description=Reconcile commonThing origin/main to verified production
Documentation=https://github.com/heimgewebe/commonthing
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/weltgewebe-reconcile-production-main
# 76 is an explicit waiting-for-approval result, not a failed deployment.
SuccessExitStatus=76
EnvironmentFile=-/etc/weltgewebe/production-reconciler.env
UMask=0077
TimeoutStartSec=7200
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
