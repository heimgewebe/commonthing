(app_common) {
	encode zstd gzip

	# The API exposes metrics on its internal service port 8080. Do not expose
	# operational metrics through the public application edge.
	handle /api/metrics {
		respond 404
	}
	handle /api/metrics/* {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8080 {
			# Caddy owns the client-IP chain. Never pass a public client's
			# RFC 7239 header to an API that trusts this proxy peer.
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /health/proxy {
		respond 200
	}

	handle /health/* {
		reverse_proxy api:8080 {
			# Caddy owns the client-IP chain. Never pass a public client's
			# RFC 7239 header to an API that trusts this proxy peer.
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle_path /local-basemap/* {
		header Cache-Control "no-cache, must-revalidate"
		@pmtiles path_regexp \.pmtiles$
		handle @pmtiles {
			root * /srv/weltgewebe-basemap
			header Content-Type "application/octet-stream"
			header Access-Control-Allow-Origin "*"
			header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
			header Access-Control-Expose-Headers "Content-Type, Content-Range, Accept-Ranges, Content-Length"
			header Access-Control-Allow-Headers "Range, If-None-Match"
			@options {
				method OPTIONS
			}
			respond @options 204
			file_server
		}

		@meta path_regexp \.meta\.json$
		handle @meta {
			root * /srv/weltgewebe-basemap
			file_server
		}

		handle {
			root * /srv/weltgewebe-map-style
			file_server
		}
	}

	handle /_app/immutable/* {
		root * /srv/weltgewebe-web
		@immutableAsset {
			file {
				root /srv/weltgewebe-web
			}
			not path */
		}
		header @immutableAsset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /_app/version.json {
		root * /srv/weltgewebe-web
		header Cache-Control "no-store"
		file_server
	}

	# Schaubild is a separately versioned, digest-pinned Schauwerk runtime.
	# Caddy owns public HTTPS and strips /schaubild before forwarding to the
	# private sidecar; the runtime still emits public URLs under /schaubild.
	@schauwerkRoot path /schaubild
	handle @schauwerkRoot {
		redir * /schaubild/ 308
	}

	handle_path /schaubild/* {
		reverse_proxy schaubild:8765 {
			# The sidecar accepts client identity only from this trusted Caddy hop.
			# Strip any client-supplied forwarding chain and send exactly one peer IP.
			header_up Host 127.0.0.1:8765
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Legacy static filenames must never reach the SvelteKit document. The
	# generated map.html bootstraps the canonical /map route and otherwise
	# reloads itself forever. Redirect only this exact path and preserve its
	# query string verbatim.
	@legacyMapHtml path /map.html
	handle @legacyMapHtml {
		route {
			uri replace /map.html /map
			redir {uri} 308
		}
	}

	# Canonicalize a trailing slash only when the slashless path has a real
	# prerendered HTML artifact. Unknown slash paths remain direct 404 responses.
	@trailingSlash path_regexp ^/.+/$
	handle @trailingSlash {
		route {
			uri strip_suffix /
			@prerendered file {
				root /srv/weltgewebe-web
				try_files {path}.html {path}/index.html
			}
			redir @prerendered {uri} 308
			respond 404
		}
	}

	handle {
		root * /srv/weltgewebe-web
		# Serve only real files or explicitly prerendered Svelte routes.
		# Unknown paths must remain real 404 responses instead of soft-200 app shells.
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# The magic-link confirmation endpoint intentionally serves one tiny HTML form.
	# Caddy is the canonical public CSP owner: defer the write so any upstream CSP
	# is replaced after proxying. All other API/health responses stay non-document locked.
	# style-src is bound to the sha256 of MAGIC_LINK_CONFIRM_STYLE in
	# apps/api/src/routes/auth.rs; the security-headers guard re-derives it.
	@magicLinkConfirm {
		method GET
		path /api/auth/magic-link/consume
	}
	header @magicLinkConfirm >Content-Security-Policy "default-src 'none'; style-src 'sha256-XYsxxeVpv60caZc9t5I3otd7S/55JHCBDH1oEdipHSY='; form-action 'self'; base-uri 'none'; frame-ancestors 'none';"
	@nonDocumentResponse {
		path /api/* /health/*
		not {
			method GET
			path /api/auth/magic-link/consume
		}
	}
	header @nonDocumentResponse >Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
	@schauwerkResponse path /schaubild /schaubild/*
	header @schauwerkResponse >Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; frame-src https://embed.diagrams.net; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
	@frontendResponse {
		not path /api/* /health/* /schaubild /schaubild/*
	}
	header @frontendResponse Content-Security-Policy "style-src 'self'; connect-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self'; media-src 'self'; manifest-src 'self'; child-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"

	header {
		# Script execution is intentionally document-owned: SvelteKit emits a hash-bound
		# meta CSP for every served HTML artifact. An edge default-src/script-src would
		# intersect with that policy and block the hash-authorized inline bootstrap.
		# The static CSP preflight validates every HTML artifact and rejects active SVGs.
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Weltgewebe-Build "{$WELTGEWEBE_BUILD}"
	}

	handle_errors {
		header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
		header X-Content-Type-Options "nosniff"
		respond "request failed" {err.status_code}
	}
}

(api_common) {
	encode zstd gzip

	# The public API hostname is not a Prometheus scrape target.
	handle /metrics {
		respond 404
	}
	handle /metrics/* {
		respond 404
	}

	handle /health/proxy {
		respond 200
	}
	reverse_proxy api:8080 {
		# Caddy owns the client-IP chain. Never pass a public client's
		# RFC 7239 header to an API that trusts this proxy peer.
		header_up -Forwarded
		header_up X-Forwarded-For {remote_host}
	}
	header {
		Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# The canonical HTTP app site remains intentionally narrow: it supports
# pre-DNS smoke tests for health/API readiness, but does not serve the full app
# over plaintext. All other public web hosts redirect directly to the canonical
# HTTPS apex while preserving path and query through {uri}.
http://commonthing.net {
	route {
		header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
		header X-Content-Type-Options "nosniff"

		handle /health/proxy {
			respond 200
		}

		handle /api/metrics {
			respond 404
		}
		handle /api/metrics/* {
			respond 404
		}

		handle_path /api/* {
			reverse_proxy api:8080 {
				# Caddy owns the client-IP chain. Never pass a public client's
				# RFC 7239 header to an API that trusts this proxy peer.
				header_up -Forwarded
				header_up X-Forwarded-For {remote_host}
			}
		}

		redir https://commonthing.net{uri} 308
	}
}

http://www.commonthing.net, http://weltgewebe.net, http://www.weltgewebe.net {
	redir https://commonthing.net{uri} 308
}

# The commonThing API hostname is added before its DNS cutover. Keep the legacy
# hostname on the same route until compatibility retirement is separately proven.
http://api.commonthing.net, http://api.weltgewebe.net {
	header Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
	header X-Content-Type-Options "nosniff"

	handle /health/proxy {
		respond 200
	}

	handle /health/* {
		reverse_proxy api:8080 {
			# Caddy owns the client-IP chain. Never pass a public client's
			# RFC 7239 header to an API that trusts this proxy peer.
			header_up -Forwarded
			header_up X-Forwarded-For {remote_host}
		}
	}

	redir https://{host}{uri} 308
}

https://commonthing.net {
	import app_common
}

https://www.commonthing.net, https://weltgewebe.net, https://www.weltgewebe.net {
	redir https://commonthing.net{uri} 308
}

https://api.commonthing.net, https://api.weltgewebe.net {
	import api_common
}