# Weltgewebe environment template (Gate C)
# Copy to .env and adjust values for local development.
# Values mirror the defaults baked into compose.core.yml so contributors can
# spin up the stack without hunting for connection details.

# Shared defaults
NODE_ENV=development
RUST_LOG=info

# Web application: Der Vite-Dev-Server läuft auf Port 5173
# (Konfiguration in apps/web, kein Env-Schalter).

# API service
API_BIND=0.0.0.0:8080
# Enable dev login endpoints (for local development only). Set to 1 to enable.
AUTH_DEV_LOGIN=0
# Cookie security (set to 0 only if accessing via HTTP locally)
AUTH_COOKIE_SECURE=1
# Persistent browser-session lifetime in seconds.
# Default: 30 days. Accepted range: 1 hour (3600) to 90 days (7776000).
AUTH_SESSION_TTL_SECONDS=2592000
# Reverse proxies whose X-Forwarded-For / Forwarded headers may set the client IP.
# Comma-separated IPs and CIDRs. Unset defaults to loopback only (127.0.0.1,::1).
# Use the literal value `none` to declare that the API is exposed directly.
#
# The API refuses to start when a per-IP rate limit
# (AUTH_RL_IP_PER_MIN / AUTH_RL_IP_PER_HOUR) is set while this stays unset:
# behind an untrusted proxy every client would share a single rate-limit bucket.
# Every listed address/CIDR is a security boundary: that proxy must overwrite
# X-Forwarded-For with the real peer address and remove any client-supplied
# Forwarded header. The shipped Caddyfiles enforce this contract.
# For Docker Compose, trust the bridge network:
# AUTH_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Domain persistence. Reads and the remaining legacy account/node writers stay JSONL by default.
# Edge/Faden projection is read-only unless PostgreSQL is selected explicitly.
WELTGEWEBE_DOMAIN_READ_SOURCE=jsonl
WELTGEWEBE_DOMAIN_ACCOUNT_WRITE_SOURCE=jsonl
WELTGEWEBE_DOMAIN_NODE_WRITE_SOURCE=jsonl
WELTGEWEBE_DOMAIN_EDGE_WRITE_SOURCE=read_only

# Unknown allow-listed addresses can be provisioned during Magic-Link login.
# Safe default: gast. `weber` requires a concrete email/domain allowlist;
# `admin` and open-registration + `weber` are rejected at startup.
# AUTH_AUTO_PROVISION=false
# AUTH_AUTO_PROVISION_ROLE=gast

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weltgewebe
POSTGRES_USER=welt
POSTGRES_PASSWORD=gewebe
# Host connections (containers use service DNS names)
DATABASE_URL=postgres://welt:gewebe@localhost:5432/weltgewebe
PGBOUNCER_URL=postgres://welt:gewebe@localhost:6432/weltgewebe

# Messaging (optional during Gate C)
# NATS_URL=nats://localhost:4222

# Web Push for private messages (optional; all three values are required together).
# The private VAPID key is a 32-byte P-256 private scalar encoded as unpadded
# base64url. Keep the real value only in the runtime secret environment.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_CONTACT=mailto:betrieb@example.invalid
# Outbound endpoints are accepted only on these exact DNS suffixes or subdomains.
# Extend this deliberately if another browser provider is introduced.
# WEB_PUSH_ALLOWED_HOST_SUFFIXES=fcm.googleapis.com,push.services.mozilla.com,web.push.apple.com
