# Commonthing: independent public watcher and opt-in durable alert transport every five minutes (Heimberry user alex)
# No cron mail; missing enrollment fails the sender closed without preventing watcher heartbeat.
MAILTO=""
*/5 * * * * /usr/bin/python3 -B /home/alex/.local/commonthing-production-watch.py >/dev/null 2>&1; /usr/bin/python3 -B /home/alex/.local/commonthing-production-watch-dispatch.py >/dev/null 2>&1
