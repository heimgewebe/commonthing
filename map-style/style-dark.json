{
  "version": 8,
  "name": "commonThing Sovereign Basemap \u2014 Dark",
  "metadata": {
    "weltgewebe:version": "0.4.0",
    "weltgewebe:note": "Regional PMTiles sources with visible landcover and landuse; bare aliases are resolved by the runtime protocol handler; dark basemap palette",
    "weltgewebe:colorScheme": "dark"
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles://basemap-hamburg.pmtiles"
    },
    "basemap-schleswig-holstein": {
      "type": "vector",
      "url": "pmtiles://basemap-schleswig-holstein.pmtiles"
    }
  },
  "glyphs": "/local-basemap/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#12181a"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "farmland",
          "#2a2e24",
          "grass",
          "#243028",
          "wood",
          "#1e2a22",
          "wetland",
          "#1f2a2a",
          "sand",
          "#2e2c24",
          "#242a28"
        ],
        "fill-opacity": 0.92
      }
    },
    {
      "id": "landcover-schleswig-holstein",
      "type": "fill",
      "source": "basemap-schleswig-holstein",
      "source-layer": "landcover",
      "minzoom": 7,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "farmland",
          "#2a2e24",
          "grass",
          "#243028",
          "wood",
          "#1e2a22",
          "wetland",
          "#1f2a2a",
          "sand",
          "#2e2c24",
          "#242a28"
        ],
        "fill-opacity": 0.92
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 8,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#2a2f30",
          "industrial",
          "#2c2a2a",
          "commercial",
          "#302a2a",
          "retail",
          "#322c2a",
          "cemetery",
          "#273028",
          "school",
          "#2c2c28",
          "university",
          "#2c2c28",
          "hospital",
          "#302a2c",
          "military",
          "#2c2a26",
          "quarry",
          "#2a2a26",
          "pitch",
          "#243028",
          "#2a2c2a"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "landuse-schleswig-holstein",
      "type": "fill",
      "source": "basemap-schleswig-holstein",
      "source-layer": "landuse",
      "minzoom": 8,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#2a2f30",
          "industrial",
          "#2c2a2a",
          "commercial",
          "#302a2a",
          "retail",
          "#322c2a",
          "cemetery",
          "#273028",
          "school",
          "#2c2c28",
          "university",
          "#2c2c28",
          "hospital",
          "#302a2c",
          "military",
          "#2c2a26",
          "quarry",
          "#2a2a26",
          "pitch",
          "#243028",
          "#2a2c2a"
        ],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1a3348"
      }
    },
    {
      "id": "water-schleswig-holstein",
      "type": "fill",
      "source": "basemap-schleswig-holstein",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1a3348"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#4a585c",
        "line-width": 1.5
      }
    },
    {
      "id": "roads-schleswig-holstein",
      "type": "line",
      "source": "basemap-schleswig-holstein",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#4a585c",
        "line-width": 1.5
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "paint": {
        "fill-color": "#2a3336",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "buildings-schleswig-holstein",
      "type": "fill",
      "source": "basemap-schleswig-holstein",
      "source-layer": "building",
      "paint": {
        "fill-color": "#2a3336",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 14
      },
      "paint": {
        "text-color": "#d5e0dc",
        "text-halo-color": "#0e1517",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-labels-schleswig-holstein",
      "type": "symbol",
      "source": "basemap-schleswig-holstein",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 14
      },
      "paint": {
        "text-color": "#d5e0dc",
        "text-halo-color": "#0e1517",
        "text-halo-width": 1
      }
    }
  ]
}
