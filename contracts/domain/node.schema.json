{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/node.schema.json",
  "title": "Node",
  "description": "A commons node in the graph. Location is an optional geographic projection.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Immutable creator binding assigned by the server. Legacy or anonymized nodes may omit it or expose null."
    },
    "info": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000,
      "description": "Freitext-Info (Markdown erlaubt)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short summary. A longer 'description' field is reserved for future use."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "address": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "description": "Optional human-readable address, independent of location; omit or use null when absent."
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false,
      "description": "Optional complete WGS84 coordinate pair. Missing or null means no map projection."
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
