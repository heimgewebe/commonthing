{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/node.schema.json",
  "title": "Node",
  "description": "A node in the Weltgewebe graph.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "place",
        "resource",
        "project",
        "event",
        "need",
        "offer"
      ],
      "description": "One canonical primary node kind; no generic default."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_account_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Immutable creator binding assigned by the server. Legacy or anonymized nodes may omit it or expose null."
    },
    "info": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000,
      "description": "Freitext-Info (Markdown erlaubt)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Short summary. A longer 'description' field is reserved for future use."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable address. Optional for records persisted before this field existed."
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
