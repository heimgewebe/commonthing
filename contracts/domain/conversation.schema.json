{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/conversation.schema.json",
  "title": "Conversation",
  "description": "A canonical public node/governance conversation or a participants-only direct conversation.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_type": {
      "type": "string",
      "enum": ["node", "governance_proposal", "direct"]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["active", "archived"]
    },
    "node_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "node_id_snapshot": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "node_title_snapshot": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "participants"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "conversation_type",
    "lifecycle_state",
    "node_id",
    "node_id_snapshot",
    "node_title_snapshot",
    "visibility",
    "created_at",
    "updated_at",
    "archived_at",
    "deleted_at"
  ],
  "allOf": [
    {
      "if": {
        "required": ["conversation_type", "lifecycle_state"],
        "properties": {
          "conversation_type": { "const": "node" },
          "lifecycle_state": { "const": "active" }
        }
      },
      "then": {
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "node_id_snapshot": { "type": "null" },
          "node_title_snapshot": { "type": "null" },
          "archived_at": { "type": "null" },
          "visibility": { "const": "public" }
        }
      }
    },
    {
      "if": {
        "required": ["conversation_type", "lifecycle_state"],
        "properties": {
          "conversation_type": { "const": "node" },
          "lifecycle_state": { "const": "archived" }
        }
      },
      "then": {
        "properties": {
          "node_id": { "type": "null" },
          "node_id_snapshot": { "type": "string", "minLength": 1 },
          "node_title_snapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "archived_at": { "type": "string", "format": "date-time" },
          "visibility": { "const": "public" }
        }
      }
    },
    {
      "if": {
        "required": ["conversation_type"],
        "properties": {
          "conversation_type": { "const": "governance_proposal" }
        }
      },
      "then": {
        "properties": {
          "lifecycle_state": { "const": "active" },
          "node_id": { "type": "null" },
          "node_id_snapshot": { "type": "null" },
          "node_title_snapshot": { "type": "null" },
          "archived_at": { "type": "null" },
          "visibility": { "const": "public" }
        }
      }
    },
    {
      "if": {
        "required": ["conversation_type"],
        "properties": {
          "conversation_type": { "const": "direct" }
        }
      },
      "then": {
        "properties": {
          "lifecycle_state": { "const": "active" },
          "node_id": { "type": "null" },
          "node_id_snapshot": { "type": "null" },
          "node_title_snapshot": { "type": "null" },
          "visibility": { "const": "participants" },
          "archived_at": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
