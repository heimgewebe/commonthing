{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://weltgewebe.org/schemas/domain/message.schema.json",
  "title": "Message",
  "description": "A canonical human or system message. System circle events belong to an account_event conversation and carry their typed kind in domain_personal_event_messages, not as a fictitious human direct chat.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "author_account_id": {
      "description": "NULL for system-created messages or deleted human authors; never fabricate a person for an automatic event.",
      "type": ["string", "null"]
    },
    "author_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "content": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "id",
    "conversation_id",
    "author_account_id",
    "author_title",
    "created_at",
    "updated_at",
    "deleted_at",
    "content"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "deleted_at": { "type": "null" } },
        "required": ["deleted_at"]
      },
      "then": {
        "properties": {
          "content": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      },
      "else": {
        "properties": { "content": { "type": "null" } }
      }
    }
  ]
}
