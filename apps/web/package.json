{
  "name": "weltgewebe-web",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.11.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0",
      "rollup": "4.60.2",
      "flatted": "3.4.4",
      "picomatch@^2.0.0": "2.3.2",
      "devalue": "^5.8.1",
      "postcss": "8.5.26",
      "yaml@^1.0.0": "1.10.3",
      "protocol-buffers-schema": "3.6.1",
      "@eslint/plugin-kit": "0.7.2",
      "js-yaml": "^4.2.0",
      "brace-expansion@^5.0.0": "5.0.9"
    }
  },
  "scripts": {
    "generate:basemap-config": "node scripts/generate-basemap-config.js",
    "dev": "pnpm run generate:client-version && pnpm run generate:basemap-config && vite dev --host",
    "build:prepare": "pnpm run sync && rimraf build",
    "build:finalize": "node scripts/generate-version.js --server --artifact-tree",
    "build": "pnpm run build:prepare && vite build && pnpm run build:finalize",
    "build:container": "pnpm run build:prepare && vite build && pnpm run build:finalize && node scripts/assert-route-performance-budget.mjs --budget-only",
    "postbuild": "node scripts/assert-route-performance-budget.mjs --budget-only",
    "preview": "vite preview",
    "clean": "rimraf node_modules .svelte-kit build",
    "postinstall": "node ./scripts/verify-cookie-version.js",
    "precheck": "pnpm run sync",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "precheck:ci": "pnpm run sync",
    "check:ci": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier -w .",
    "prelint": "pnpm run generate:basemap-config",
    "lint": "prettier -c . && eslint . --max-warnings=0",
    "screenshot": "node scripts/record-screenshot.mjs",
    "build:e2e": "pnpm run build:prepare && cross-env VITE_PUBLIC_ENABLE_TEST_MAP=true vite build --mode test && pnpm run build:finalize",
    "pretest": "pnpm run generate:basemap-config",
    "pretest:ci": "pnpm run generate:basemap-config",
    "pretest:proof:basemap-real": "cross-env PUBLIC_BASEMAP_MODE=local-sovereign PUBLIC_BASEMAP_VARIANT=regional pnpm run generate:basemap-config",
    "pretest:proof:basemap-germany": "cross-env PUBLIC_BASEMAP_MODE=local-sovereign PUBLIC_BASEMAP_VARIANT=germany pnpm run generate:basemap-config",
    "pretest:proof:web-runtime": "pnpm run generate:basemap-config",
    "pretest:proof:map-cardinality-fullstack": "pnpm run generate:basemap-config",
    "pretest:unit": "pnpm run generate:client-version && pnpm run generate:basemap-config",
    "test:unit": "vitest run",
    "test:basemap-config": "node --test scripts/generate-basemap-config.test.mjs scripts/basemap-mode-resolve.test.mjs",
    "test:pmtiles-validator": "node --test scripts/validate-pmtiles.test.mjs",
    "test:public-web-assets": "node --test scripts/generate-public-web-assets.test.mjs",
    "test:web-runtime-evidence": "node --test scripts/web-runtime-evidence.test.mjs",
    "validate:pmtiles": "node scripts/validate-pmtiles.mjs",
    "test": "playwright test",
    "test:proof:auth-passkey-register": "playwright test --config=playwright.auth.proof.config.ts --reporter=dot,html,junit",
    "test:proof:auth-session-persistence": "playwright test --config=playwright.auth-session.proof.config.ts",
    "test:proof:governance-full-flow": "playwright test --config=playwright.governance.proof.config.ts",
    "test:proof:basemap-real": "cross-env PUBLIC_BASEMAP_MODE=local-sovereign PUBLIC_BASEMAP_VARIANT=regional playwright test --config=playwright.proof.config.ts --reporter=dot,html,junit",
    "test:proof:basemap-germany": "cross-env PUBLIC_BASEMAP_MODE=local-sovereign PUBLIC_BASEMAP_VARIANT=germany playwright test --config=playwright.germany.proof.config.ts --reporter=dot,html,junit",
    "test:proof:web-runtime": "playwright test --config=playwright.performance.config.ts",
    "test:proof:map-cardinality-fullstack": "playwright test --config=playwright.cardinality-fullstack.config.ts",
    "assert:proof:web-runtime": "node scripts/assert-web-runtime-evidence.mjs",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=dot,html,junit",
    "report": "playwright show-report playwright-report",
    "test:setup": "node ./node_modules/@playwright/test/cli.js install --with-deps || true",
    "sync": "node scripts/generate-version.js --client && pnpm run generate:basemap-config && svelte-kit sync",
    "preci": "pnpm run generate:basemap-config",
    "ci": "node ../../ci/scripts/assert-web-budget.mjs && pnpm test:route-performance-budget && pnpm test:web-runtime-evidence && pnpm test:map-cardinality-evidence && pnpm test:map-cardinality-fullstack-evidence && pnpm test:public-web-assets && pnpm test:basemap-config && pnpm lint && pnpm check:ci",
    "dev:cs": "node scripts/generate-version.js --client && pnpm run generate:basemap-config && vite dev --host 0.0.0.0 --port 5173",
    "preview:cs": "vite preview --host 0.0.0.0 --port 4173",
    "generate:client-version": "node scripts/generate-version.js --client",
    "measure:map-start-path": "node scripts/map-start-path-closure.mjs",
    "test:route-performance-budget": "node --test scripts/assert-route-performance-budget.test.mjs scripts/performance-contract.test.mjs scripts/build-profile-contract.test.mjs scripts/map-start-path-closure.test.mjs",
    "test:map-cardinality-evidence": "node --test scripts/map-cardinality-evidence.test.mjs",
    "test:map-cardinality-fullstack-evidence": "node --test scripts/map-cardinality-fullstack-evidence.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mapbox/vector-tile": "1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@playwright/test": "1.61.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.69.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "cross-env": "^10.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "16.5.0",
    "pbf": "3.3.0",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "rimraf": "6.1.3",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "maplibre-gl": "4.7.1",
    "pmtiles": "^4.4.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0",
    "pnpm": ">=9.11.0 <10"
  }
}
